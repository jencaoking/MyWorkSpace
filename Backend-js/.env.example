# 复制为 .env 并填入真实值；.env 切勿提交到仓库
# 数据库
DB_HOST=localhost
DB_NAME=mywork
DB_USER=mywork
DB_PASS=your_strong_password

# 后台管理员密码（明文或 bcrypt 哈希均可；未设置则默认 admin123）
SELFWORK_ADMIN_PASSWORD=

# 可选：App 接口共享令牌（设置后客户端需携带 Authorization: Bearer <token>）
SELFWORK_API_TOKEN=

# 第三方 API Key（由服务端代理，不下发客户端；也可在后台管理中填写存到 app_config 表）
TMDB_KEY=
QWEATHER_KEY=
YOUDAO_APP_KEY=
YOUDAO_APP_SECRET=

# 服务监听端口
PORT=3000
