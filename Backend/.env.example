# 后台管理管理员密码注入（复制为 .env 并填入真实值）
# 支持两种写法：明文 或 bcrypt 哈希（password_hash 生成，以 $2y$ 开头）
# 例如：
#   SELFWORK_ADMIN_PASSWORD=你的强密码
#   SELFWORK_ADMIN_PASSWORD=$2y$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SELFWORK_ADMIN_PASSWORD=

# App 接口共享令牌（可选）：配置后，所有 /api 与 /sync 接口（/api/health 除外）
# 必须在请求头携带 Authorization: Bearer <token> 或 X-Api-Token: <token>，否则返回 401。
# 未配置则不强制鉴权（开发态兼容）。建议使用高强度随机串，例如：
#   SELFWORK_API_TOKEN=$(php -r 'echo bin2hex(random_bytes(32));')
SELFWORK_API_TOKEN=
